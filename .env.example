# Leave empty in development: Vite proxies /v1 to the auth API (see vite.config.ts).
# In production set the public URL of atm-auth-api (it must allow this origin via CORS).
VITE_API_URL=
# Leave empty in development: Vite proxies /storage-api to the storage API (see vite.config.ts).
# In production it defaults to the same-origin /storage-api prefix; set the public URL of atm-storage-api
# only if it is served elsewhere (it must allow this origin via WEB_CORS_ORIGINS).
VITE_STORAGE_API_URL=
# Leave empty in development: Vite proxies /documents-api to the documents API (see vite.config.ts).
# In production it defaults to the same-origin /documents-api prefix, which the host nginx forwards.
VITE_DOCUMENTS_API_URL=
