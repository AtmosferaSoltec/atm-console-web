# Add this location to the host nginx server block of console.atmosferast.com,
# next to /storage-api/ and /pulso-api/, then `nginx -t && nginx -s reload`.
# It gives the console atm-billing-api on its own origin (no CORS needed): the "Cobros" section
# with the superadmin's access token, and the public statement page of each client (/statement/<token>).

location /billing-api/ {
	client_max_body_size 64k;
	proxy_pass http://127.0.0.1:3134/;
	proxy_http_version 1.1;
	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $auth_client_ip;
	proxy_set_header X-Forwarded-For $auth_client_ip;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header Connection "";
	proxy_read_timeout 20s;
	proxy_send_timeout 20s;
}
