# Add these two locations to the host nginx server block of console.atmosferast.com,
# next to /storage-api/ and /documents-api/, then `nginx -t && nginx -s reload`.
# They give the console the messaging API on its own origin (no CORS needed): the
# admin calls and the public page where a customer scans their WhatsApp QR.

# QR streams (Server-Sent Events): never buffer them and let them stay open.
location ~ ^/messaging-api/(public/connect/[^/]+|v1/sessions/[^/]+)/qr/stream$ {
	rewrite ^/messaging-api/(.*)$ /$1 break;
	proxy_pass http://127.0.0.1:3121;
	proxy_http_version 1.1;
	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $auth_client_ip;
	proxy_set_header X-Forwarded-For $auth_client_ip;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header Connection "";
	proxy_buffering off;
	proxy_cache off;
	proxy_read_timeout 1h;
}

location /messaging-api/ {
	# Messages carry attachments as base64 inside the JSON (up to 16 MiB of file).
	client_max_body_size 25m;
	proxy_pass http://127.0.0.1:3121/;
	proxy_http_version 1.1;
	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $auth_client_ip;
	proxy_set_header X-Forwarded-For $auth_client_ip;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header Connection "";
	proxy_read_timeout 60s;
	proxy_send_timeout 60s;
}
