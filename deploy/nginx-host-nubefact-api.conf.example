# Add inside the server block of the console (console.atmosferast.com), next to the other service locations.
# The billing API (atm-nubefact-api) is reached on the console origin, so the browser needs no CORS. The container
# publishes 127.0.0.1:3041. Its /admin routes accept the superadmin token of atm-auth-api.
location /nubefact-api/ {
	proxy_pass http://127.0.0.1:3041/;
	proxy_http_version 1.1;
	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $auth_client_ip;
	proxy_set_header X-Forwarded-For $auth_client_ip;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_read_timeout 45s;
	proxy_send_timeout 45s;
}
