# Add this location to the host nginx server block of console.atmosferast.com,
# next to /storage-api/ and /documents-api/, then `nginx -t && nginx -s reload`.
# It gives the console the Pulso API on its own origin (no CORS needed), used by the
# "Pulso > Sedes" section with the superadmin's access token.

location /pulso-api/ {
	proxy_pass http://127.0.0.1:3081/;
	proxy_http_version 1.1;
	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $auth_client_ip;
	proxy_set_header X-Forwarded-For $auth_client_ip;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header Connection "";
	proxy_read_timeout 60s;
	proxy_send_timeout 60s;
}
